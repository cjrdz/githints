{
  // Terraform and OpenTofu. A module is a directory, so a file is named by
  // its directory and every .tf file in it is one node, as a Go package's
  // files are; `source = "./modules/vpc"` links to it. Registry and git
  // module sources keep their address.
  //
  // Block labels are quoted (resource "aws_s3_bucket" "logs"), so the symbol
  // rules read the view that keeps strings. A resource is named by its own
  // label, with its type as the signature.
  //
  // Terragrunt's terragrunt.hcl is read too, by name: its `source` and a
  // dependency's `config_path` link it to the module directories it deploys
  // and depends on. Other .hcl files are not claimed: Packer, Nomad, Vault
  // and Consul write the same syntax with blocks of their own, and
  // .terraform.lock.hcl is generated. Neither are .tfvars files, which
  // assign values and declare nothing this spec indexes.
  "language": "terraform",
  "extensions": [".tf", ".tofu"],
  "filenames": ["terragrunt.hcl"],
  "depth_style": "brace",

  "comments": { "line": ["#", "//"], "block": [["/*", "*/"]] },
  "strings": [
    { "open": "\"", "close": "\"", "escape": "\\", "interp_open": "${", "interp_close": "}" }
  ],

  "import_path": "directory",

  "symbols": [
    { "kind": "type", "requires": "resource", "keep_strings": true,
      "pattern": "^\\s*resource\\s+\"(?P<sig>[\\w-]+)\"\\s+\"(?P<name>[\\w-]+)\"" },
    { "kind": "type", "requires": "module", "keep_strings": true,
      "pattern": "^\\s*module\\s+\"(?P<name>[\\w-]+)\"" },
    { "kind": "var", "requires": "variable", "keep_strings": true,
      "pattern": "^\\s*variable\\s+\"(?P<name>[\\w-]+)\"" },
    { "kind": "const", "requires": "output", "keep_strings": true,
      "pattern": "^\\s*output\\s+\"(?P<name>[\\w-]+)\"" }
  ],

  "imports": [
    { "requires": "source", "relative": true,
      "pattern": "^\\s*source\\s*=\\s*\"(?P<path>\\.\\.?/[^\"]*)\"" },
    { "requires": "source",
      "pattern": "^\\s*source\\s*=\\s*\"(?P<path>[^\".][^\"]*)\"" },
    // Terragrunt: dependency "vpc" { config_path = "../vpc" }.
    { "requires": "config_path", "relative": true,
      "pattern": "^\\s*config_path\\s*=\\s*\"(?P<path>\\.\\.?/[^\"]*)\"" }
  ]
}
