{
  // Pistache: Routes::Get(router, "/users/:id", Routes::bind(...)).
  "framework": "pistache",
  "languages": ["cpp"],
  "when_imports": ["pistache"],
  "when_dependencies": ["pistache", "Pistache"],
  "rules": [
    {
      "facet": "route",
      "requires": "Routes::",
      "keep_strings": true,
      "pattern": "\\bRoutes::(?P<detail>Get|Post|Put|Patch|Delete|Head|Options)\\(\\s*[\\w.]+\\s*,\\s*\"(?P<name>[^\"]*)\""
    }
  ]
}
