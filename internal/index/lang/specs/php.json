{
  // PHP.
  //
  // PSR-4 maps a namespace to a directory through composer.json, which is not
  // derivable from the path alone, so PHP files contribute symbols and imports
  // but no graph edges.
  //
  // Heredoc and nowdoc are not modelled. Their bodies are treated as code,
  // which can produce a spurious match from text that looks like a
  // declaration; the alternative was mis-modelling them and blanking real code.
  "language": "php",
  "extensions": [".php"],
  "depth_style": "brace",

  "comments": { "line": ["//", "#"], "block": [["/*", "*/"]] },
  "strings": [
    { "open": "\"", "close": "\"", "escape": "\\" },
    { "open": "'", "close": "'", "escape": "\\" }
  ],

  "import_path": "",

  "symbols": [
    {
      "kind": "type",
      "requires": "class",
      "pattern": "^\\s*(?:(?:abstract|final|readonly)\\s+)*class\\s+(?P<name>\\w+)"
    },
    {
      "kind": "type",
      "requires": "interface",
      "pattern": "^\\s*interface\\s+(?P<name>\\w+)"
    },
    {
      "kind": "type",
      "requires": "trait",
      "pattern": "^\\s*trait\\s+(?P<name>\\w+)"
    },
    {
      "kind": "type",
      "requires": "enum",
      "pattern": "^\\s*enum\\s+(?P<name>\\w+)"
    },
    {
      "kind": "func",
      "requires": "function",
      "pattern": "^\\s*(?:(?:public|private|protected|static|abstract|final)\\s+)*function\\s+&?(?P<name>\\w+)\\s*\\((?P<sig>[^)]*)\\)"
    },
    {
      "kind": "const",
      "requires": "const",
      "pattern": "^\\s*(?:(?:public|private|protected|final)\\s+)*const\\s+(?P<name>\\w+)\\s*="
    }
  ],

  "imports": [
    { "requires": "use", "pattern": "^\\s*use\\s+(?:function\\s+|const\\s+)?(?P<path>[\\w\\\\]+)" }
  ]
}
