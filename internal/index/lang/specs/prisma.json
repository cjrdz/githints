{
  // Prisma schema files.
  //
  // A schema is imported by nothing, so it has no inbound key. Relations
  // between models are real outbound edges and are recorded; they point at
  // models rather than files, so they render as plain text.
  "language": "prisma",
  "extensions": [".prisma"],
  "depth_style": "brace",

  "comments": { "line": ["//"] },
  "strings": [{ "open": "\"", "close": "\"", "escape": "\\" }],

  "import_path": "",

  "symbols": [
    { "kind": "type", "requires": "model", "pattern": "^\\s*model\\s+(?P<name>\\w+)\\s*\\{" },
    { "kind": "type", "requires": "enum", "pattern": "^\\s*enum\\s+(?P<name>\\w+)\\s*\\{" },
    { "kind": "type", "requires": "type", "pattern": "^\\s*type\\s+(?P<name>\\w+)\\s*\\{" },
    { "kind": "type", "requires": "view", "pattern": "^\\s*view\\s+(?P<name>\\w+)\\s*\\{" },
    { "kind": "var", "requires": "datasource", "pattern": "^\\s*datasource\\s+(?P<name>\\w+)\\s*\\{" },
    { "kind": "var", "requires": "generator", "pattern": "^\\s*generator\\s+(?P<name>\\w+)\\s*\\{" }
  ],

  "imports": [
    {
      // A list relation: `posts Post[]`.
      "requires": "[]",
      "pattern": "^\\s+\\w+\\s+(?P<path>[A-Z]\\w*)\\[\\]"
    },
    {
      // An explicit relation: `author User @relation(...)`. Matching on
      // @relation is what separates a model reference from a scalar field;
      // RE2 has no lookahead, so excluding Int, String and the rest by
      // negation is not available.
      "requires": "@relation",
      "pattern": "^\\s+\\w+\\s+(?P<path>[A-Z]\\w*)\\??\\s+@relation"
    }
  ]
}
