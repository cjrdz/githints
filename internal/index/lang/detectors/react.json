{
  // React. A component is a function returning JSX, which a line matcher
  // cannot see, so this leans on the naming convention React itself enforces:
  // a component must start with a capital letter or JSX will not render it.
  //
  // That means a capitalised non-component function in a React file is a
  // false positive. The convention is strong enough in practice, and the
  // alternative -- reporting no components at all -- is worse.
  "framework": "react",
  "languages": ["typescript"],
  "when_imports": ["react", "react-dom"],
  "rules": [
    {
      "facet": "component",
      "requires": "function",
      "pattern": "^\\s*(?:export\\s+)?(?:default\\s+)?function\\s+(?P<name>[A-Z]\\w*)\\s*\\("
    },
    {
      // const Foo = (props) => ... and const Foo: FC<P> = () => ...
      "facet": "component",
      "requires": "=>",
      "pattern": "^\\s*(?:export\\s+)?(?:const|let)\\s+(?P<name>[A-Z]\\w*)\\s*(?::[^=]+)?=\\s*(?:\\([^)]*\\)|\\w+)\\s*(?::[^=]+)?=>"
    }
  ]
}
